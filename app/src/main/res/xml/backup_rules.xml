<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 10 and 11; Android 12 and later read data_extraction_rules.xml instead. Her log and
    settings are backed up only when the backup is end-to-end encrypted with the phone's screen lock
    (docs/decisions/0004-backup-encryption.md).
-->
<full-backup-content>
    <include domain="database" path="." requireFlags="clientSideEncryption" />
    <include domain="file" path="datastore/" requireFlags="clientSideEncryption" />
</full-backup-content>
