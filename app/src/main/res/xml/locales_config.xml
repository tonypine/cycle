<?xml version="1.0" encoding="utf-8"?>
<!--
    The languages Cycle has strings for, listed on Android 13's per-app language page (Android
    Settings › Apps › Cycle › Language). A language is added here, to Language.Supported and to
    localeFilters in the PR that adds its strings; LanguagesTest keeps the lists in step
    (docs/decisions/0008-languages.md).
-->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="en" />
    <locale android:name="pt-BR" />
    <locale android:name="es" />
    <locale android:name="de" />
</locale-config>
